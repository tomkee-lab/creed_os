{
  "servers": {
    "greptile": {
      "type": "http",
      "url": "https://api.greptile.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:GREPTILE_API_KEY}"
      }
    },
    "kokonutui": {
      "command": "pnpm",
      "args": [
        "--silent",
        "dlx",
        "shadcn@latest",
        "mcp"
      ]
    }
  }
}
