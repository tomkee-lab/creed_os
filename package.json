{
  "name": "core-os-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "CREED OS: AI-Native Learner Intelligence & Navigation Platform",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "lint:css": "pnpm --filter web lint:css",
    "lint:css:fix": "pnpm --filter web lint:css:fix",
    "clean": "turbo run clean",
    "design:audit": "node --experimental-strip-types design-system.audit.ts",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook",
    "chromatic": "pnpm build-storybook && chromatic --project-token=chpt_122ddc086d158ba --storybook-build-dir=apps/web/storybook-static",
    "greptile:review": "greptile review",
    "greptile:status": "greptile review status",
    "greptile:config": "greptile config"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^22.20.5",
    "chromatic": "^18.11.0",
    "d3-scale": "^4.0.2",
    "greptile": "^3.6.1",
    "svelte": "^5.57.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.14"
  }
