# ============================================================
# Core_OS Environment Variables
# Copy this file to .env.local and fill in your values.
# The application runs in dual-mode:
#   - Without Supabase vars: uses the high-fidelity in-memory
#     local repository (zero setup required).
#   - With Supabase vars: connects to your Supabase project.
# ============================================================

# ----------------------------------------------------------
# Better Auth & Production Data Plane (Required for Auth)
# ----------------------------------------------------------
BETTER_AUTH_SECRET=your-high-entropy-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_API_KEY=ba_xhihtaiijro050sofc7nl5nr31pwr7yh
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_AUTH_URL=http://localhost:5173

# ----------------------------------------------------------
# Supabase (Optional — needed for live multi-user database)
# ----------------------------------------------------------
# Found at: https://app.supabase.com > Project Settings > API
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ----------------------------------------------------------
# Google Gemini API (Optional — needed for live AI responses)
# ----------------------------------------------------------
# Without this, the Socratic Mentor uses the built-in
# deterministic pedagogical fallback engine.
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ----------------------------------------------------------
# Greptile Code Intelligence & MCP (Optional)
# ----------------------------------------------------------
# Get your API key: https://app.greptile.com/settings/api
# Used for CLI reviews, CI workflows, and MCP server queries.
GREPTILE_API_KEY=your-greptile-api-key

# ----------------------------------------------------------
# Chromatic Visual Testing & Storybook (Optional)
# ----------------------------------------------------------
# Found at: https://www.chromatic.com/manage?appId=...
# Used for visual regression snapshots & Storybook deployments.
CHROMATIC_PROJECT_TOKEN=your-chromatic-project-token

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
# Deployment origin (used for CORS and absolute URL generation)
# Default is http://localhost:5173 for local dev.
# ORIGIN=https://your-production-domain.com
